// Schema Prisma — Habita+ (fonte de verdade do modelo).
//
// Fronteira dura com o Regulariza+ (spec §2): NENHUMA chave estrangeira atravessa. O que existe
// é ConsultaExterna — o registro de que perguntamos algo à API do irmão, e o que ele respondeu.
//
// Toda tabela de domínio carrega tenantId, carimbo de auditoria e exclusão lógica. RLS entra por
// SQL cru na migration (Prisma não gera policy), com FORCE ROW LEVEL SECURITY e papel de runtime
// sem BYPASSRLS — a dívida conhecida do irmão, corrigida de saída.

generator client {
  provider = "prisma-client-js"
}

// Prisma 7: a URL de conexão fica em prisma.config.ts (CLI/migrate); o PrismaClient recebe um
// driver adapter (@prisma/adapter-pg). PostGIS é habilitado por SQL cru na migration inicial.
datasource db {
  provider = "postgresql"
}

// ───────────────────────── Plataforma ─────────────────────────

enum EsferaUsuario {
  PLATAFORMA
  TENANT
  MUNICIPE
}

enum PerfilTenant {
  ADMINISTRADOR
  GESTOR_HABITACAO
  TECNICO_SOCIAL
  ATENDENTE
  FISCAL_OBRAS
  ANALISTA_MUTUARIO
  JURIDICO
  FISCAL_AUDITOR
  /// Perfis de setor externo: entram pelo encaminhamento e não alcançam a fila nem a ficha.
  DEFESA_CIVIL
  SETOR_PARCEIRO
}

enum StatusUsuario {
  ATIVO
  BLOQUEADO
  INATIVO
}

enum ActorType {
  TENANT
  PLATFORM
  SYSTEM
  MUNICIPE
}

enum AuditOperation {
  INSERT
  UPDATE
  DELETE
  READ
}

enum SerieProtocolo {
  HAB
  AUX
  MUT
  REA
  FIS
  /// Ofício de convocação e recurso têm numeração própria: são atos distintos da inscrição, e
  /// misturá-los no mesmo contador tornaria a sequência impossível de auditar.
  OFC
  REC
  /// Código público da família — a mesma numeração por prefeitura e ano das demais séries.
  FAM
  /// Encaminhamento entre setores.
  ENC
  /// Documento juntado ao processo.
  DOC
  /// Pilha documental montada para entrega externa.
  PIL
  /// Produção habitacional: convênio, empreendimento, medição e unidade.
  CNV
  EMP
  MED
  UNI
  /// Visita de acompanhamento pós-entrega.
  VIS
  /// Processo de retomada de unidade.
  RET
}

/// Tipo do setor — o município nomeia como quiser, mas a integração precisa saber o papel.
/// É o que permite dizer "encaminhe à Defesa Civil" sem depender do nome que cada prefeitura usa.
enum TipoSetor {
  HABITACAO
  ASSISTENCIA_SOCIAL
  DEFESA_CIVIL
  OBRAS
  JURIDICO
  PLANEJAMENTO_URBANO
  MEIO_AMBIENTE
  FAZENDA
  GABINETE
  CONTROLE_INTERNO
  OUTRO
}

/// O que está sendo pedido ao outro setor. Define o efeito da resposta no processo da Habitação:
/// laudo de risco respondido pela Defesa Civil passa a valer como evidência na ficha da família,
/// que é o que a spec §6.3 exige — risco é evidência de terceiro, não marcação do servidor.
enum TipoSolicitacao {
  LAUDO_RISCO
  PARECER_JURIDICO
  VISTORIA_TECNICA
  ANALISE_PROJETO
  APOIO_SOCIAL
  OUTRO
}

enum SituacaoEncaminhamento {
  ABERTO
  RESPONDIDO
  DEVOLVIDO
  CANCELADO
}

/// A que entidade o documento pertence. Um catálogo só, escopos distintos: o mesmo mecanismo
/// serve para o RG do requerente e para o edital do programa.
enum EscopoDocumento {
  PESSOA
  FAMILIA
  INSCRICAO
  PROGRAMA
  CONVENIO
  OBRA
  UNIDADE
  CONTRATO
  CASO_RETOMADA
}

enum SituacaoDocumento {
  RECEBIDO
  CONFERIDO
  RECUSADO
  SUBSTITUIDO
}

/// Para que a pilha está sendo montada. Cada finalidade tem sua lista de exigências — a do
/// cartório não é a mesma da prestação de contas do convênio.
enum FinalidadePilha {
  REGISTRO_CARTORIO
  PRESTACAO_CONTAS
  HABITE_SE
  CONTRATO_MUTUARIO
  RETOMADA_UNIDADE
  OUTRA
}

enum SituacaoPilha {
  EM_MONTAGEM
  COMPLETA
  ENTREGUE
}

enum PapelSignatario {
  PREFEITO
  VICE_PREFEITO
  SECRETARIO
  DIRETOR_HABITACAO
  PROCURADOR
  OUTRO
}

/// Prefeitura. Unidade de isolamento: todo dado de domínio pendura aqui, e a RLS escopa por ela.
model Tenant {
  id         String  @id @default(cuid())
  nome       String
  cnpj       String  @unique @db.VarChar(14)
  municipio  String
  uf         String  @db.Char(2)
  timezone   String  @default("America/Cuiaba")
  brasaoKey  String?
  /// Parâmetros do município: salário mínimo de referência, prazos, textos de ofício.
  parametros Json    @default("{}")
  ativo      Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String
  updatedBy String
  deletedAt DateTime?
  deletedBy String?

  usuarios    Usuario[]
  setores     Setor[]
  signatarios Signatario[]
  familias    Familia[]
  pessoas     Pessoa[]
  programas   ProgramaHabitacional[]
  convenios       Convenio[]
  empreendimentos Empreendimento[]
  obras           Obra[]
  unidades        UnidadeHabitacional[]

  @@index([ativo])
  @@map("tenant")
}

model Usuario {
  id                 String        @id @default(cuid())
  /// Nulo apenas na esfera PLATAFORMA — quem cria prefeitura não pertence a nenhuma.
  tenantId           String?
  esfera             EsferaUsuario @default(TENANT)
  perfil             PerfilTenant?
  /// Setor do servidor. Nulo = lotado na Habitação (o setor dono do sistema).
  setorId            String?
  nome               String
  email              String
  cpf                String?       @db.Char(11)
  senhaHash          String
  status             StatusUsuario @default(ATIVO)
  trocarSenhaNoLogin Boolean       @default(true)
  ultimoAcessoEm     DateTime?
  /// Lockout automático anti brute-force — distinto do bloqueio manual do administrador.
  tentativasFalhas   Int           @default(0)
  bloqueadoAte       DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String
  updatedBy String
  deletedAt DateTime?
  deletedBy String?

  tenant        Tenant?             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  setor         Setor?              @relation(fields: [setorId], references: [id], onDelete: SetNull)
  capacidades   UsuarioCapacidade[]
  refreshTokens RefreshToken[]

  @@unique([email])
  @@index([tenantId, status])
  @@map("usuario")
}

/// Concessão ou revogação explícita de capacidade (spec §5). Ação sensível não vem do cargo:
/// sem uma linha aqui, o guard nega. Revogação vence concessão.
model UsuarioCapacidade {
  id         String  @id @default(cuid())
  tenantId   String
  usuarioId  String
  capacidade String
  concedida  Boolean @default(true)
  /// Por que esta prefeitura entregou (ou tirou) esta ação deste servidor.
  motivo     String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String
  updatedBy String

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, capacidade])
  @@index([tenantId])
  @@map("usuario_capacidade")
}

/// Refresh token com rotação: o valor apresentado é `id.segredo`, e só o hash do segredo fica
/// gravado. Existe apenas para servidor — o munícipe entra com protocolo + CPF a cada sessão, e
/// não carrega credencial de longa duração ligada ao próprio CPF.
model RefreshToken {
  id        String    @id @default(cuid())
  usuarioId String
  tokenHash String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@map("refresh_token")
}

/// Unidade organizacional da prefeitura. A Habitação opera o sistema; os demais setores entram
/// por encaminhamento, e só enxergam o que lhes foi encaminhado (ver policies na migration).
model Setor {
  id         String    @id @default(cuid())
  tenantId   String
  nome       String
  sigla      String
  tipo       TipoSetor
  /// Secretaria a que o setor pertence, quando o município organiza em dois níveis.
  secretaria String?
  email      String?
  ativo      Boolean   @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String
  updatedBy String
  deletedAt DateTime?
  deletedBy String?

  tenant           Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  usuarios         Usuario[]
  encaminhamentosEnviados  Encaminhamento[] @relation("SetorOrigem")
  encaminhamentosRecebidos Encaminhamento[] @relation("SetorDestino")

  @@unique([tenantId, sigla])
  @@index([tenantId, tipo, ativo])
  @@map("setor")
}

/// Tramitação entre setores.
///
/// É o mecanismo que liga os módulos sem fundi-los: a Habitação pede laudo à Defesa Civil, parecer
/// ao Jurídico, vistoria às Obras. O encaminhamento aponta para a entidade em questão (família,
/// inscrição, obra, caso de risco) e carrega o prazo — sem prazo, encaminhar vira arquivar.
model Encaminhamento {
  id            String                 @id @default(cuid())
  tenantId      String
  numero        String
  setorOrigemId String
  setorDestinoId String
  /// Entidade referenciada, em par tipo + id. Não é chave estrangeira de propósito: o mesmo
  /// mecanismo serve para qualquer módulo, inclusive os que ainda não existem.
  entidade      String
  entidadeId    String
  tipoSolicitacao TipoSolicitacao @default(OUTRO)
  assunto       String
  descricao     String
  /// Resumo do caso, escrito pela Habitação no ato do encaminhamento.
  ///
  /// O setor de destino lê ISTO, não a ficha da família. É a mesma escolha da fronteira com o
  /// Regulariza+: o que atravessa é o que foi declarado de propósito — a Defesa Civil precisa do
  /// endereço e do caso, não da renda.
  referenciaResumo String
  prazoAte      DateTime
  situacao      SituacaoEncaminhamento @default(ABERTO)

  resposta      String?
  respondidoEm  DateTime?
  respondidoPor String?
  /// Documento anexado na resposta (laudo, parecer, auto de vistoria).
  anexoKey      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String
  updatedBy String

  setorOrigem  Setor @relation("SetorOrigem", fields: [setorOrigemId], references: [id], onDelete: Restrict)
  setorDestino Setor @relation("SetorDestino", fields: [setorDestinoId], references: [id], onDelete: Restrict)

  @@unique([tenantId, numero])
  @@index([tenantId, setorDestinoId, situacao])
  @@index([tenantId, entidade, entidadeId])
  @@index([tenantId, prazoAte])
  @@map("encaminhamento")
}

/// Catálogo de tipos de documento do município.
///
/// Cada prefeitura tem a sua lista — o que uma exige como "comprovante de residência" a outra
/// aceita como conta de luz. O tipo carrega a validade: documento com prazo vence sozinho e
/// reabre a pendência, em vez de ficar velho no processo sem ninguém notar.
model TipoDocumento {
  id           String          @id @default(cuid())
  tenantId     String
  codigo       String
  nome         String
  escopo       EscopoDocumento
  /// Meses de validade a partir da emissão. Nulo = não vence (RG, certidão de nascimento).
  validadeMeses Int?
  aceitaFoto   Boolean         @default(true)
  /// O que o atendente fala para a família: "conta de luz dos últimos 3 meses, em nome de…".
  orientacao   String?
  ativo        Boolean         @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String
  updatedBy String
  deletedAt DateTime?
  deletedBy String?

  documentos  Documento[]
  exigencias  ExigenciaDocumental[]
  itensPilha  ItemPilha[]

  @@unique([tenantId, codigo])
  @@index([tenantId, escopo, ativo])
  @@map("tipo_documento")
}

/// Documento anexado a uma entidade.
///
/// `escopo` + `referenciaId` apontam para o dono (família, programa, contrato) sem chave
/// estrangeira: o mesmo mecanismo precisa servir para módulos que ainda não existem. A conferência
/// é ato registrado — anexar não é o mesmo que aceitar.
model Documento {
  id              String            @id @default(cuid())
  tenantId        String
  tipoDocumentoId String
  escopo          EscopoDocumento
  referenciaId    String
  protocolo       String

  arquivoKey  String
  nomeArquivo String
  mimeType    String
  tamanho     Int

  emitidoEm DateTime?
  validoAte DateTime?

  situacao     SituacaoDocumento @default(RECEBIDO)
  conferidoPor String?
  conferidoEm  DateTime?
  motivoRecusa String?
  observacao   String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String
  updatedBy String
  deletedAt DateTime?
  deletedBy String?

  tipo       TipoDocumento @relation(fields: [tipoDocumentoId], references: [id], onDelete: Restrict)
  itensPilha ItemPilha[]

  @@unique([tenantId, protocolo])
  @@index([tenantId, escopo, referenciaId])
  @@index([tenantId, validoAte])
  @@map("documento")
}

/// O que um programa exige de quem se inscreve. Vira pendência com prazo na inscrição.
model ExigenciaDocumental {
  id              String  @id @default(cuid())
  tenantId        String
  programaId      String
  tipoDocumentoId String
  obrigatorio     Boolean @default(true)
  prazoDias       Int     @default(30)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String
  updatedBy String

  programa ProgramaHabitacional @relation(fields: [programaId], references: [id], onDelete: Cascade)
  tipo     TipoDocumento        @relation(fields: [tipoDocumentoId], references: [id], onDelete: Restrict)

  @@unique([programaId, tipoDocumentoId])
  @@index([tenantId, programaId])
  @@map("exigencia_documental")
}

/// Pilha documental: o conjunto que vai a algum lugar de fora.
///
/// É o que resolve o problema do cartório. A prefeitura abre "Registro — unidade 118", o sistema
/// lista o que aquela finalidade exige, marca o que já existe, e o índice sai na ordem de juntada.
/// Sem isso, montar a pilha é conferência manual e a família volta ao balcão por um papel.
model PilhaDocumental {
  id           String          @id @default(cuid())
  tenantId     String
  finalidade   FinalidadePilha
  escopo       EscopoDocumento
  referenciaId String
  nome         String
  situacao     SituacaoPilha   @default(EM_MONTAGEM)
  observacao   String?
  /// PDF do índice de juntada, gerado quando a pilha fecha.
  indiceKey    String?
  entregueEm   DateTime?
  entreguePara String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String
  updatedBy String

  itens ItemPilha[]

  @@index([tenantId, escopo, referenciaId])
  @@index([tenantId, situacao])
  @@map("pilha_documental")
}

model ItemPilha {
  id              String  @id @default(cuid())
  tenantId        String
  pilhaId         String
  tipoDocumentoId String
  documentoId     String?
  ordem           Int
  obrigatorio     Boolean @default(true)
  observacao      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String
  updatedBy String

  pilha     PilhaDocumental @relation(fields: [pilhaId], references: [id], onDelete: Cascade)
  tipo      TipoDocumento   @relation(fields: [tipoDocumentoId], references: [id], onDelete: Restrict)
  documento Documento?      @relation(fields: [documentoId], references: [id], onDelete: SetNull)

  @@unique([pilhaId, tipoDocumentoId])
  @@index([tenantId, pilhaId])
  @@map("item_pilha")
}

/// Quem assina ofício de convocação, termo e declaração.
model Signatario {
  id       String          @id @default(cuid())
  tenantId String
  nome     String
  papel    PapelSignatario
  cargo    String
  cpf      String?         @db.Char(11)
  ativo    Boolean         @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String
  updatedBy String
  deletedAt DateTime?
  deletedBy String?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId, ativo])
  @@map("signatario")
}

/// Trilha append-only: sem UPDATE e sem DELETE nas policies. Diff já chega mascarado.
model AuditLog {
  id        String         @id @default(cuid())
  tenantId  String?
  actorType ActorType
  actorId   String?
  operation AuditOperation
  entity    String
  entityId  String?
  diff      Json?
  ip        String?
  createdAt DateTime       @default(now())

  @@index([tenantId, entity, entityId])
  @@index([tenantId, createdAt])
  @@index([actorId])
  @@map("audit_log")
}

/// Cada leitura feita na API do Regulariza+ (spec §7): o evento é auditável dos dois lados, e é
/// o que sustenta a checagem de duplicidade de benefício sem copiar banco.
model ConsultaExterna {
  id            String   @id @default(cuid())
  tenantId      String
  /// CPF consultado, guardado inteiro: a consulta precisa ser reproduzível numa auditoria.
  cpf           String   @db.Char(11)
  familiaId     String?
  finalidade    String
  encontrou     Boolean
  /// Resumo da resposta (processo, fase, data da ficha). Nunca a ficha inteira do irmão.
  resposta      Json?
  consultadoPor String
  createdAt     DateTime @default(now())

  familia Familia? @relation(fields: [familiaId], references: [id], onDelete: SetNull)

  @@index([tenantId, cpf])
  @@index([tenantId, createdAt])
  @@map("consulta_externa")
}

/// Sequencial do protocolo público por tenant, série e ano.
model ContadorProtocolo {
  id       String         @id @default(cuid())
  tenantId String
  serie    SerieProtocolo
  ano      Int
  ultimo   Int            @default(0)

  updatedAt DateTime @updatedAt

  @@unique([tenantId, serie, ano])
  @@map("contador_protocolo")
}

