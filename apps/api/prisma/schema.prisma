  INATIVA
  TRANSFERIDA
}

model Pessoa {
  id          String    @id @default(cuid())
  tenantId    String
  cpf         String    @db.Char(11)
  nome        String
  nascimento  DateTime? @db.Date
  sexo        Sexo      @default(NAO_INFORMADO)
  nis         String?   @db.VarChar(11)
  telefone    String?
  telefoneAlternativo String?
  email       String?

  /// Filiação. O pai "não informado" é declaração, e é diferente de campo em branco por descuido —
  /// a distinção importa em documento que vai a cartório.
  nomeMae             String?
  nomePai             String?
  nomePaiNaoInformado Boolean @default(false)

  estadoCivil EstadoCivil?
  regimeBens  RegimeBens?

  rg             String?
  orgaoExpedidor String?
  rgUf           String? @db.Char(2)
  /// Declarou não possuir RG. Sem isso, a ficha fica eternamente "incompleta" para quem não tem.
  rgAusente      Boolean @default(false)

  nacionalidade String?
  naturalidade  String?
  profissao     String?
  escolaridade     Escolaridade?
  situacaoTrabalho SituacaoTrabalho?

  deficiencia       Boolean           @default(false)
  tiposDeficiencia  TipoDeficiencia[]
  usaCadeiraDeRodas Boolean           @default(false)
  necessitaCuidador Boolean           @default(false)

  /// Endereço atual. É o que a Defesa Civil e o técnico social usam para chegar na casa.
  cep         String? @db.Char(8)
  logradouro  String?
  numero      String?
  complemento String?
  bairro      String?
  municipio   String?
  uf          String? @db.Char(2)
  referencia  String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String
  updatedBy String
  deletedAt DateTime?
  deletedBy String?

  tenant             Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  membros            MembroFamiliar[]
  familiasResponsavel Familia[]      @relation("ResponsavelFamiliar")

  @@unique([tenantId, cpf])
  @@index([tenantId, nome])
  @@map("pessoa")
}

/// Unidade de atendimento do produto — não é a pessoa (spec §4). É o grupo que entra na fila.
model Familia {
  id            String          @id @default(cuid())
  tenantId      String
  codigo        String
  responsavelId String
  situacao      SituacaoFamilia @default(ATIVA)
  observacao    String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String
  updatedBy String
  deletedAt DateTime?
  deletedBy String?

  tenant       Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  responsavel  Pessoa            @relation("ResponsavelFamiliar", fields: [responsavelId], references: [id], onDelete: Restrict)
  membros      MembroFamiliar[]
  fichas       FichaSocial[]
  visitas      VisitaDomiciliar[]
  inscricoes   InscricaoFila[]
  consentimentos ConsentimentoDado[]
  consultas    ConsultaExterna[]
  unidades     UnidadeHabitacional[]

  @@unique([tenantId, codigo])
  @@index([tenantId, situacao])
  @@map("familia")
}

model MembroFamiliar {
  id         String     @id @default(cuid())
  tenantId   String
  familiaId  String
  pessoaId   String
  parentesco Parentesco
  /// Contribui para a renda familiar declarada.
  contribuiRenda Boolean @default(false)
  renda          Decimal? @db.Decimal(14, 2)

  escolaridade     Escolaridade?
  frequentaEscola  Boolean?
  tipoEscola       TipoEscola?
  turnoEscola      TurnoEscola?
  nomeEscola       String?

  situacaoTrabalho SituacaoTrabalho?
  ocupacao         String?

  doencaCronica    Boolean @default(false)
  gestante         Boolean @default(false)
  entrouEm   DateTime   @default(now())
  saiuEm     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String
  updatedBy String

  familia Familia @relation(fields: [familiaId], references: [id], onDelete: Cascade)
  pessoa  Pessoa  @relation(fields: [pessoaId], references: [id], onDelete: Restrict)

  @@unique([familiaId, pessoaId])
  @@index([tenantId])
  @@map("membro_familiar")
}

/// Ficha social com validade. Nova apuração cria nova ficha — a anterior não é sobrescrita,
/// porque snapshot de pontuação antigo precisa continuar explicável.
model FichaSocial {
  id        String @id @default(cuid())
  tenantId  String
  familiaId String

  rendaFamiliar     Decimal @db.Decimal(14, 2)
  rendaPerCapita    Decimal @db.Decimal(14, 2)
  fonteRenda        FonteRenda?
  regimeRenda       RegimeRenda?
  rendaComplementar Boolean @default(false)
  rendaComplementarDesc String?
  /// Pessoas no grupo familiar segundo a apuração. Fica na ficha, e não na contagem de membros
  /// cadastrados, porque a composição é o que o técnico apurou na visita — o cadastro nominal
  /// dos membros pode estar incompleto sem invalidar a renda per capita já calculada.
  quantidadePessoas Int     @default(1)
  fonteRendaPrincipal String?
  /// NIS/CadÚnico digitado no balcão: sem validação na base federal, é dado não verificado —
  /// a interface precisa dizer isso, e o roadmap prevê a consulta oficial (spec §8).
  nis               String?  @db.VarChar(11)
  nisVerificado     Boolean  @default(false)
  inscritoCadUnico  Boolean  @default(false)
  beneficios        BeneficioSocial[]
  beneficioAtivo    String?

  estruturaFamiliar       EstruturaFamiliar?
  vulnerabilidades        IndicadorVulnerabilidade[]
  nivelVulnerabilidade    NivelVulnerabilidade?
  /// Parecer técnico da visita. Texto de conteúdo social — mascarado na trilha.
  parecerTecnico          String?

  mulherChefeFamilia     Boolean @default(false)
  temPessoaComDeficiencia Boolean @default(false)
  temIdoso               Boolean @default(false)
  quantidadeMenores      Int     @default(0)
  situacaoRisco          Boolean @default(false)
  /// Laudo da Defesa Civil que fundamenta a situação de risco. Sem ele o critério de risco não
  /// pontua (spec §6.3): risco não é campo que o servidor marca, é evidência de terceiro. Na
  /// fase 3 vira relação com LaudoRisco; aqui é o anexo, que já sustenta a mesma regra.
  laudoRiscoKey          String?
  laudoRiscoEmitidoEm    DateTime?

  tipoMoradia        TipoMoradia
  tipoConstrucao     TipoConstrucao
  saneamento         Saneamento
  situacaoHabitacional SituacaoHabitacional?
  comodos            Int?
  banheiros          Int?
  /// Infraestrutura do entorno — o que separa "casa ruim" de "lugar sem serviço público".
  abastecimentoAgua  AbastecimentoAgua?
  energiaEletrica    EnergiaEletrica?
  coletaLixo         ColetaLixo?
  pavimentacao       Pavimentacao?
  iluminacaoPublica  Boolean?
  drenagemPluvial    Boolean?
  acessoEscolaProxima     Boolean?
  acessoSaudeProxima      Boolean?
  acessoTransportePublico Boolean?
  moradiaInadequada  Boolean  @default(false)
  possuiOutroImovel  Boolean  @default(false)
  mesesResidenciaMunicipio Int  @default(0)

  origem              OrigemFicha @default(PROPRIA)
  /// Processo do Regulariza+ que originou o pré-preenchimento, se houve.
  origemProcessoExterno String?
  origemConsultadaEm  DateTime?

  apuradaEm DateTime
  validaAte DateTime
  vigente   Boolean  @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String
  updatedBy String
  deletedAt DateTime?
  deletedBy String?

  familia Familia @relation(fields: [familiaId], references: [id], onDelete: Cascade)

  @@index([tenantId, familiaId, vigente])
  @@index([tenantId, validaAte])
  @@map("ficha_social")
}

model VisitaDomiciliar {
  id        String   @id @default(cuid())
  tenantId  String
  familiaId String
  visitadaEm DateTime
  parecer   String
  /// Ponto da visita (SRID 4326). Geometria entra por SQL cru — ver migration de PostGIS.
  latitude  Decimal? @db.Decimal(10, 7)
  longitude Decimal? @db.Decimal(10, 7)
  fotos     Json     @default("[]")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String
  updatedBy String
  deletedAt DateTime?
  deletedBy String?

  familia Familia @relation(fields: [familiaId], references: [id], onDelete: Cascade)

  @@index([tenantId, familiaId])
  @@map("visita_domiciliar")
}

/// Consentimento registrado antes de qualquer pré-preenchimento vindo do Regulariza+ (spec §8).
/// Finalidade distinta sob a LGPD exige base legal própria — o aceite fica gravado, com o texto
/// exato que a família leu na tela.
model ConsentimentoDado {
  id            String   @id @default(cuid())
  tenantId      String
  familiaId     String
  finalidade    String
  textoVersao   String
  concedidoPor  String
  /// Nome de quem assinou no balcão (o responsável familiar), para prova do aceite.
  assinadoPor   String
  concedidoEm   DateTime @default(now())
  revogadoEm    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String
  updatedBy String

  familia Familia @relation(fields: [familiaId], references: [id], onDelete: Cascade)

  @@index([tenantId, familiaId])
  @@map("consentimento_dado")
}

// ───────────────────────── Fila de programas ─────────────────────────

enum SituacaoPrograma {
  RASCUNHO
  INSCRICOES_ABERTAS
  INSCRICOES_ENCERRADAS
  EM_EXECUCAO
  ENCERRADO
}

enum SituacaoVersaoCriterio {
  RASCUNHO
  PUBLICADA
  SUBSTITUIDA
}

enum SituacaoInscricao {
  EM_ANALISE
  PENDENTE
  APTA
  EM_RECURSO
  CONVOCADA
  CONTEMPLADA
  INDEFERIDA
  INELEGIVEL
  DESISTENTE
  CANCELADA
}

enum MotivoCalculo {
  INSCRICAO
  ATUALIZACAO_FICHA
  RECALCULO_LOTE
  RECURSO
  RECADASTRAMENTO
}

enum DesfechoConvocacao {
  COMPARECEU
  NAO_COMPARECEU
  RECUSOU
  INELEGIVEL
}

enum DecisaoRecurso {
  DEFERIDO
  INDEFERIDO
  PARCIALMENTE_DEFERIDO
}

enum SituacaoPendencia {
  ABERTA
  RESOLVIDA
  DISPENSADA
  VENCIDA
}

model ProgramaHabitacional {
  id             String           @id @default(cuid())
  tenantId       String
  nome           String
  slug           String
  fonteRecurso   String
  vagas          Int
  inscricaoInicio DateTime
  inscricaoFim   DateTime
  regulamentoKey String?
  situacao       SituacaoPrograma @default(RASCUNHO)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String
  updatedBy String
  deletedAt DateTime?
  deletedBy String?

  tenant     Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  versoes    VersaoCriterio[]
  inscricoes InscricaoFila[]
  rankings   RankingPublicacao[]
  exigencias ExigenciaDocumental[]
  empreendimentos Empreendimento[]

  @@unique([tenantId, slug])
  @@index([tenantId, situacao])
  @@map("programa_habitacional")
}

/// Conjunto de critérios de um programa. Enquanto RASCUNHO, `definicoes` é editável; publicada,
/// vira imutável — mudar peso exige nova versão (spec §8). O snapshot aponta para a versão que
/// valia, e é por isso que recalcular não reescreve o passado.
model VersaoCriterio {
  id          String                 @id @default(cuid())
  tenantId    String
  programaId  String
  versao      Int
  situacao    SituacaoVersaoCriterio @default(RASCUNHO)
  /// Array de DefinicaoCriterio (contrato em @habita/shared/habitacao).
  definicoes  Json
  publicadoEm DateTime?
  publicadoPor String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String
  updatedBy String

  programa  ProgramaHabitacional @relation(fields: [programaId], references: [id], onDelete: Cascade)
  snapshots PontuacaoSnapshot[]
  rankings  RankingPublicacao[]

  @@unique([programaId, versao])
  @@index([tenantId, programaId, situacao])
  @@map("versao_criterio")
}

model InscricaoFila {
  id         String            @id @default(cuid())
  tenantId   String
  programaId String
  familiaId  String
  protocolo  String
  situacao   SituacaoInscricao @default(EM_ANALISE)
  inscritaEm DateTime          @default(now())
  /// Motivo do último desfecho negativo (recusa, inelegibilidade, cancelamento) — obrigatório
  /// no caso de uso que o registra, para que a fila nunca perca alguém em silêncio.
  motivoSituacao String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String
  updatedBy String
  deletedAt DateTime?
  deletedBy String?

  programa    ProgramaHabitacional @relation(fields: [programaId], references: [id], onDelete: Restrict)
  familia     Familia              @relation(fields: [familiaId], references: [id], onDelete: Restrict)
  snapshots   PontuacaoSnapshot[]
  convocacoes Convocacao[]
  recursos    Recurso[]
  pendencias  Pendencia[]
  itensRanking RankingItem[]

  @@unique([tenantId, protocolo])
  @@unique([programaId, familiaId])
  @@index([tenantId, programaId, situacao])
  @@map("inscricao_fila")
}

/// Nota congelada. Tabela própria — e não coluna em InscricaoFila — porque recalcular não pode
/// apagar o que valia antes (spec §7).
model PontuacaoSnapshot {
  id               String        @id @default(cuid())
  tenantId         String
  inscricaoId      String
  versaoCriterioId String
  total            Decimal       @db.Decimal(6, 1)
  totalMaximo      Decimal       @db.Decimal(6, 1)
  /// Itens do cálculo (código, pontos, peso, base, observação) — a nota explicada linha a linha.
  itens            Json
  /// Fatos usados no cálculo, congelados: a ficha muda, o snapshot não.
  fatos            Json
  motivo           MotivoCalculo
  vigente          Boolean       @default(true)
  calculadoEm      DateTime      @default(now())
  calculadoPor     String

  createdAt DateTime @default(now())
  createdBy String

  inscricao      InscricaoFila  @relation(fields: [inscricaoId], references: [id], onDelete: Cascade)
  versaoCriterio VersaoCriterio @relation(fields: [versaoCriterioId], references: [id], onDelete: Restrict)

  @@index([tenantId, inscricaoId, vigente])
  @@index([tenantId, calculadoEm])
  @@map("pontuacao_snapshot")
}

/// Ranking publicado: o ato formal que abre prazo de recurso. Congelado em itens próprios para
/// que a lista de hoje continue existindo depois do próximo recálculo.
model RankingPublicacao {
  id               String   @id @default(cuid())
  tenantId         String
  programaId       String
  versaoCriterioId String
  publicadoEm      DateTime @default(now())
  publicadoPor     String
  prazoRecursoAte  DateTime
  /// Quantas famílias a publicação classificou. Fica aqui, e não como contagem de ranking_item,
  /// porque na esfera do munícipe a RLS só deixa ver a própria linha — e a família precisa saber
  /// "2º entre 1.402" sem que isso signifique enxergar as outras 1.401.
  totalClassificadas Int      @default(0)
  pdfKey           String?

  createdAt DateTime @default(now())
  createdBy String

  programa       ProgramaHabitacional @relation(fields: [programaId], references: [id], onDelete: Cascade)
  versaoCriterio VersaoCriterio       @relation(fields: [versaoCriterioId], references: [id], onDelete: Restrict)
  itens          RankingItem[]

  @@index([tenantId, programaId, publicadoEm])
  @@map("ranking_publicacao")
}

/// Linha do ranking público. Identifica pelo protocolo, nunca por nome ou CPF: numa cidade
/// pequena, nome e nota juntos revelam a condição social de vizinhos identificáveis (spec §8).
model RankingItem {
  id            String  @id @default(cuid())
  tenantId      String
  publicacaoId  String
  inscricaoId   String
  posicao       Int
  protocolo     String
  pontuacao     Decimal @db.Decimal(6, 1)

  createdAt DateTime @default(now())

  publicacao RankingPublicacao @relation(fields: [publicacaoId], references: [id], onDelete: Cascade)
  inscricao  InscricaoFila     @relation(fields: [inscricaoId], references: [id], onDelete: Restrict)

  @@unique([publicacaoId, inscricaoId])
  @@unique([publicacaoId, posicao])
  @@index([tenantId, publicacaoId])
  @@map("ranking_item")
}

/// Convocação. `foraDeOrdem` é a exceção auditada da §9: só entra com capacidade concedida,
/// motivo obrigatório e publicidade junto ao ranking — e aparece num contador no painel do
/// gestor, que é o que faz a própria prefeitura controlar a porta que abriu.
model Convocacao {
  id              String              @id @default(cuid())
  tenantId        String
  inscricaoId     String
  numeroOficio    String
  emitidaEm       DateTime            @default(now())
  emitidaPor      String
  prazoComparecimentoAte DateTime
  oficioKey       String?

  foraDeOrdem     Boolean             @default(false)
  motivoExcecao   String?
  autorizadaPor   String?

  desfecho        DesfechoConvocacao?
  desfechoEm      DateTime?
  desfechoPor     String?
  motivoDesfecho  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String
  updatedBy String

  inscricao InscricaoFila @relation(fields: [inscricaoId], references: [id], onDelete: Cascade)

  @@unique([tenantId, numeroOficio])
  @@index([tenantId, inscricaoId])
  @@index([tenantId, foraDeOrdem])
  @@map("convocacao")
}

/// Recurso como entidade de primeira classe (spec §8): sem canal formal de contestação, o
/// indeferimento é vício de devido processo — e o caminho mais curto para a Justiça.
model Recurso {
  id             String          @id @default(cuid())
  tenantId       String
  inscricaoId    String
  protocolo      String
  motivo         String
  /// Situação da inscrição quando o recurso entrou. Indeferir o recurso devolve a família a este
  /// estado — sem isso, contestar a nota poderia piorar a posição de quem recorreu, e o direito
  /// de recurso viraria risco (spec §8).
  situacaoAnterior SituacaoInscricao
  apresentadoEm  DateTime        @default(now())
  /// Quem protocolou: a própria família pela central, ou o servidor no balcão.
  apresentadoPor String
  prazoRespostaAte DateTime
  decisao        DecisaoRecurso?
  fundamentacao  String?
  decididoEm     DateTime?
  decididoPor    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String
  updatedBy String

  inscricao InscricaoFila @relation(fields: [inscricaoId], references: [id], onDelete: Cascade)

  @@unique([tenantId, protocolo])
  @@index([tenantId, inscricaoId])
  @@index([tenantId, prazoRespostaAte])
  @@map("recurso")
}

/// Pendência documental com prazo. Enquanto aberta, a inscrição fica suspensa da fila.
model Pendencia {
  id          String            @id @default(cuid())
  tenantId    String
  inscricaoId String
  tipo        String
  descricao   String
  prazoAte    DateTime
  situacao    SituacaoPendencia @default(ABERTA)
  resolvidaEm DateTime?
  resolvidaPor String?
  arquivoKey  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String
  updatedBy String

  inscricao InscricaoFila @relation(fields: [inscricaoId], references: [id], onDelete: Cascade)

  @@index([tenantId, inscricaoId, situacao])
  @@index([tenantId, prazoAte])
  @@map("pendencia")
}

// ─────────────────────────────────────────────────────────────────────────────
// Produção habitacional (spec §10): convênio → empreendimento → obra → medição → unidade.
//
// A separação entre empreendimento e obra não é burocracia: o conjunto é o que a prefeitura
// entrega às famílias, e a obra é o contrato com quem constrói. Um empreendimento pode ser
// executado em lotes, por empresas diferentes, e o cronograma de cada um vive por si.
// ─────────────────────────────────────────────────────────────────────────────

enum SituacaoConvenio {
  EM_ELABORACAO
  VIGENTE
  SUSPENSO
  ENCERRADO
  CANCELADO
}

enum SituacaoEmpreendimento {
  PLANEJAMENTO
  EM_OBRA
  CONCLUIDO
  ENTREGUE
  CANCELADO
}

enum SituacaoObra {
  NAO_INICIADA
  EM_EXECUCAO
  PARALISADA
  CONCLUIDA
  RESCINDIDA
}

enum SituacaoMedicao {
  RASCUNHO
  APROVADA
  REJEITADA
  CANCELADA
}

enum SituacaoUnidade {
  PLANEJADA
  EM_OBRA
  PRONTA
  ENTREGUE
  DESOCUPADA
  EM_LITIGIO
  RETOMADA
  CANCELADA
}

/// De onde vem o dinheiro. Determina a prestação de contas e, por consequência, a pilha documental
/// que precisa existir ao fim da obra.
enum OrigemRecurso {
  FEDERAL
  ESTADUAL
  MUNICIPAL
  FGTS
  FINANCIAMENTO
  EMENDA_PARLAMENTAR
  OUTRA
}

/// Convênio ou fonte de recurso. Existe separado do empreendimento porque um convênio costuma
/// financiar mais de um conjunto — e a prestação de contas é do convênio, não da obra.
model Convenio {
  id             String           @id @default(cuid())
  tenantId       String
  protocolo      String
  /// Número no órgão repassador (Caixa, ministério, estado). É por ele que o convênio é
  /// procurado do lado de fora, e é ele que vai no ofício.
  numeroExterno  String?
  objeto         String
  origem         OrigemRecurso
  orgaoRepassador String
  valorRepasse   Decimal          @db.Decimal(14, 2)
  valorContrapartida Decimal      @default(0) @db.Decimal(14, 2)
  vigenciaInicio DateTime
  vigenciaFim    DateTime
  situacao       SituacaoConvenio @default(EM_ELABORACAO)
  observacao     String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String
  updatedBy String
  deletedAt DateTime?
  deletedBy String?

  tenant          Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  empreendimentos Empreendimento[]

  @@unique([tenantId, protocolo])
  @@index([tenantId, situacao])
  @@index([tenantId, vigenciaFim])
  @@map("convenio")
}

/// O conjunto habitacional. É o que se entrega às famílias e o que a fila enxerga.
model Empreendimento {
  id            String                 @id @default(cuid())
  tenantId      String
  protocolo     String
  nome          String
  slug          String
  convenioId    String?
  programaId    String?
  endereco      String
  bairro        String
  cep           String?                @db.Char(8)
  latitude      Decimal?               @db.Decimal(10, 7)
  longitude     Decimal?               @db.Decimal(10, 7)
  unidadesPrevistas Int
  situacao      SituacaoEmpreendimento @default(PLANEJAMENTO)
  previsaoEntrega DateTime?
  entregueEm    DateTime?
  observacao    String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String
  updatedBy String
  deletedAt DateTime?
  deletedBy String?

  tenant    Tenant                @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  convenio  Convenio?             @relation(fields: [convenioId], references: [id], onDelete: Restrict)
  programa  ProgramaHabitacional? @relation(fields: [programaId], references: [id], onDelete: Restrict)
  obras     Obra[]
  unidades  UnidadeHabitacional[]

  @@unique([tenantId, slug])
  @@unique([tenantId, protocolo])
  @@index([tenantId, situacao])
  @@map("empreendimento")
}

/// O contrato de execução. Guarda quem constrói, por quanto e até quando — e é contra ele que a
/// medição é conferida.
model Obra {
  id               String       @id @default(cuid())
  tenantId         String
  empreendimentoId String
  descricao        String
  /// Empresa executora. CNPJ alfanumérico (regra que vale a partir de julho/2026).
  executoraNome    String
  executoraCnpj    String       @db.VarChar(14)
  numeroContrato   String
  /// Anotação de responsabilidade técnica — sem ela a obra não tem responsável identificado.
  artRrt           String?
  valorContrato    Decimal      @db.Decimal(14, 2)
  /// Somatório das medições aprovadas. Materializado para não recalcular a cada leitura da lista.
  valorMedido      Decimal      @default(0) @db.Decimal(14, 2)
  percentualExecutado Decimal   @default(0) @db.Decimal(5, 2)
  inicioPrevisto   DateTime
  terminoPrevisto  DateTime
  inicioReal       DateTime?
  terminoReal      DateTime?
  situacao         SituacaoObra @default(NAO_INICIADA)
  motivoParalisacao String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String
  updatedBy String
  deletedAt DateTime?
  deletedBy String?

  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  empreendimento Empreendimento @relation(fields: [empreendimentoId], references: [id], onDelete: Restrict)
  etapas         EtapaObra[]
  medicoes       Medicao[]

  @@unique([tenantId, numeroContrato])
  @@index([tenantId, empreendimentoId])
  @@index([tenantId, situacao])
  @@map("obra")
}

/// Etapa do cronograma físico. O peso é o que impede a barra de progresso de mentir: fundação
/// pronta não é "um quarto da obra" só por ser uma de quatro etapas.
model EtapaObra {
  id          String    @id @default(cuid())
  tenantId    String
  obraId      String
  ordem       Int
  codigo      String
  nome        String
  peso        Decimal   @db.Decimal(5, 2)
  executado   Decimal   @default(0) @db.Decimal(5, 2)
  previstaAte DateTime
  concluidaEm DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String
  updatedBy String

  obra Obra @relation(fields: [obraId], references: [id], onDelete: Cascade)

  @@unique([obraId, codigo])
  @@index([tenantId, obraId])
  @@map("etapa_obra")
}

/// Medição — ordem de pagamento com outro nome. Nasce com protocolo, guarda quem mediu e quem
/// aprovou, e não pode ser editada depois de aprovada: para mudar, cancela-se com motivo.
model Medicao {
  id          String          @id @default(cuid())
  tenantId    String
  obraId      String
  protocolo   String
  numero      Int
  periodoInicio DateTime
  periodoFim  DateTime
  percentualAcumulado Decimal @db.Decimal(5, 2)
  valor       Decimal         @db.Decimal(14, 2)
  situacao    SituacaoMedicao @default(RASCUNHO)
  /// Fiscal que mediu. Guardado como texto além do id porque o servidor sai da prefeitura e o
  /// documento continua precisando dizer quem assinou.
  fiscalNome  String
  fiscalId    String?
  aprovadaEm  DateTime?
  aprovadaPor String?
  /// Obrigatório em rejeição e cancelamento: medição desfeita sem motivo é buraco na prestação
  /// de contas.
  motivo      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String
  updatedBy String

  obra Obra @relation(fields: [obraId], references: [id], onDelete: Restrict)

  @@unique([tenantId, protocolo])
  @@unique([obraId, numero])
  @@index([tenantId, obraId, situacao])
  @@map("medicao")
}

/// A casa. Vive além da obra: depois de entregue, é ela que responde por titular, uso, visita de
/// acompanhamento e eventual retomada.
model UnidadeHabitacional {
  id               String          @id @default(cuid())
  tenantId         String
  empreendimentoId String
  protocolo        String
  /// Identificação no conjunto (quadra/lote/número). É como a prefeitura chama a casa no dia a dia.
  identificacao    String
  quadra           String?
  lote             String?
  endereco         String
  cep              String?         @db.Char(8)
  tipologia        String?
  areaConstruida   Decimal?        @db.Decimal(8, 2)
  areaTerreno      Decimal?        @db.Decimal(10, 2)
  /// Matrícula no cartório de registro de imóveis — o que o registro exige e o que prova a
  /// individualização do lote.
  matricula        String?
  cartorio         String?
  inscricaoImobiliaria String?
  valorAvaliado    Decimal?        @db.Decimal(14, 2)
  situacao         SituacaoUnidade @default(PLANEJADA)
  /// Preenchido na entrega. Aponta para a família, não para a pessoa: a titularidade é do núcleo.
  familiaId        String?
  entregueEm       DateTime?
  /// Motivo da última mudança de situação. Retrocesso sem motivo é decisão que ninguém explica
  /// depois (§9).
  motivoSituacao   String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String
  updatedBy String
  deletedAt DateTime?
  deletedBy String?

  tenant           Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  empreendimento   Empreendimento          @relation(fields: [empreendimentoId], references: [id], onDelete: Restrict)
  familia          Familia?                @relation(fields: [familiaId], references: [id], onDelete: Restrict)
  acompanhamentos  AcompanhamentoUnidade[]
  ocorrencias      OcorrenciaUnidade[]
  casosRetomada    CasoRetomada[]

  @@unique([tenantId, protocolo])
  @@unique([empreendimentoId, identificacao])
  @@index([tenantId, situacao])
  @@index([tenantId, familiaId])
  @@map("unidade_habitacional")
}

// ─────────────────────────────────────────────────────────────────────────────
// Pós-entrega (spec §10.4): acompanhamento social e ocorrências de uso da unidade.
//
// Entregar a chave não encerra a responsabilidade da prefeitura — é o que o Trabalho Social
// (Portaria MDR 464/2018) chama de acompanhamento, e o que o convênio cobra na prestação de
// contas. Sem registro por unidade, o município não consegue provar que acompanhou.
// ─────────────────────────────────────────────────────────────────────────────

enum TipoAcompanhamento {
  INICIAL
  PERIODICA
  EXTRAORDINARIA
  APURACAO
}

/// Eixos do Trabalho Social. Fixos por norma federal — o município escolhe as ações, não os eixos.
enum EixoTrabalhoSocial {
  MOBILIZACAO_ORGANIZACAO
  ACOMPANHAMENTO_GESTAO
  EDUCACAO_AMBIENTAL_PATRIMONIAL
  DESENVOLVIMENTO_SOCIOECONOMICO
}

enum SituacaoEixo {
  ADEQUADA
  ATENCAO
  CRITICA
  NAO_AVALIADA
}

enum TipoOcorrenciaUso {
  CESSAO_TERCEIRO
  ALUGUEL
  VENDA_TRANSFERENCIA
  ABANDONO
  USO_COMERCIAL
  OBRA_IRREGULAR
  MUDANCA_COMPOSICAO
  OBITO_TITULAR
  OUTRA
}

enum GravidadeOcorrencia {
  ADMINISTRATIVA
  LEVE
  GRAVE
  GRAVISSIMA
}

/// De onde veio o fato. Denúncia anônima não é prova — a origem fica registrada para que a
/// decisão possa ser pesada depois, sabendo em que ela se apoiou.
enum OrigemOcorrencia {
  VISITA
  DENUNCIA
  OFICIO
  CRUZAMENTO_CADASTRAL
  OUTRA
}

enum SituacaoOcorrenciaUso {
  ABERTA
  EM_APURACAO
  NOTIFICADA
  REGULARIZADA
  IMPROCEDENTE
  ENCAMINHADA_JURIDICO
}

/// Visita de acompanhamento pós-entrega. Diferente de `VisitaDomiciliar`, que é do cadastro: esta
/// é da UNIDADE, tem periodicidade obrigatória e responde pelos eixos do Trabalho Social.
model AcompanhamentoUnidade {
  id         String             @id @default(cuid())
  tenantId   String
  unidadeId  String
  protocolo  String
  visitadaEm DateTime
  tipo       TipoAcompanhamento @default(PERIODICA)

  /// Quem visitou. Guardado como texto além do id porque o servidor sai da prefeitura e o
  /// relatório continua precisando dizer quem assinou.
  tecnicoNome String
  tecnicoId   String?

  /// O titular foi encontrado morando na unidade? É a pergunta central do pós-entrega.
  residenciaConfirmada Boolean
  /// Quem foi encontrado, quando não é o titular. Livre de propósito — a realidade não cabe em enum.
  quemReside           String?
  moradoresEncontrados Int?

  parecer   String
  latitude  Decimal? @db.Decimal(10, 7)
  longitude Decimal? @db.Decimal(10, 7)
  fotos     Json     @default("[]")

  /// Materializada no registro: a lista de unidades não pode recalcular prazo linha a linha.
  proximaVisitaEm DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String
  updatedBy String
  deletedAt DateTime?
  deletedBy String?

  unidade     UnidadeHabitacional  @relation(fields: [unidadeId], references: [id], onDelete: Restrict)
  eixos       EixoAcompanhamento[]
  ocorrencias OcorrenciaUnidade[]

  @@unique([tenantId, protocolo])
  @@index([tenantId, unidadeId, visitadaEm])
  @@map("acompanhamento_unidade")
}

/// Avaliação de um eixo do Trabalho Social na visita. Tabela e não JSON porque a prestação de
/// contas pergunta pelo eixo — "quantas famílias em situação crítica no eixo socioeconômico" é
/// consulta, não relatório manual.
model EixoAcompanhamento {
  id               String             @id @default(cuid())
  tenantId         String
  acompanhamentoId String
  eixo             EixoTrabalhoSocial
  situacao         SituacaoEixo       @default(NAO_AVALIADA)
  observacao       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String
  updatedBy String

  acompanhamento AcompanhamentoUnidade @relation(fields: [acompanhamentoId], references: [id], onDelete: Cascade)

  @@unique([acompanhamentoId, eixo])
  @@index([tenantId, eixo, situacao])
  @@map("eixo_acompanhamento")
}

/// Ocorrência de uso da unidade. É o caminho formal entre "alguém disse" e qualquer consequência:
/// apuração, notificação com prazo, e só então encaminhamento jurídico (bloco 5).
model OcorrenciaUnidade {
  id        String                @id @default(cuid())
  tenantId  String
  unidadeId String
  protocolo String
  tipo      TipoOcorrenciaUso
  gravidade GravidadeOcorrencia
  origem    OrigemOcorrencia
  situacao  SituacaoOcorrenciaUso @default(ABERTA)

  descricao String
  /// Visita que constatou o fato, quando a ocorrência nasceu de uma.
  acompanhamentoId String?

  constatadaEm         DateTime
  notificadaEm         DateTime?
  prazoRegularizacaoAte DateTime?
  encerradaEm          DateTime?
  /// Obrigatório ao encerrar. Ocorrência que some sem motivo é a que ninguém explica na auditoria.
  motivoEncerramento   String?

  /// Encaminhamento ao Jurídico, quando houve. Mantém a ponte com o fluxo entre setores.
  encaminhamentoId String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String
  updatedBy String
  deletedAt DateTime?
  deletedBy String?

  unidade        UnidadeHabitacional    @relation(fields: [unidadeId], references: [id], onDelete: Restrict)
  acompanhamento AcompanhamentoUnidade? @relation(fields: [acompanhamentoId], references: [id], onDelete: SetNull)
  casos          CasoRetomada[]

  @@unique([tenantId, protocolo])
  @@index([tenantId, unidadeId, situacao])
  @@index([tenantId, situacao, prazoRegularizacaoAte])
  @@map("ocorrencia_unidade")
}

// ─────────────────────────────────────────────────────────────────────────────
// Retomada de unidade (spec §10.5). O ato mais grave do sistema.
//
// A modelagem existe para impedir atalho: notificação com forma e comprovante, prazo de defesa,
// registro da defesa (ou da revelia), e decisão que só nasce fundamentada. É o contraditório do
// art. 5º LV da Constituição, na forma da Lei 9.784/99 — sem isso, a retomada cai no primeiro
// exame judicial e a prefeitura perde a casa e o processo.
// ─────────────────────────────────────────────────────────────────────────────

enum FaseRetomada {
  ABERTO
  NOTIFICADO
  EM_DEFESA
  EM_ANALISE
  DECIDIDO
  ENCERRADO
}

enum FormaNotificacao {
  PESSOAL
  AR_CORREIO
  EDITAL
}

enum DecisaoRetomada {
  REGULARIZACAO
  ACORDO
  RESCISAO
  ARQUIVAMENTO
}

/// Processo administrativo de retomada. Nasce de uma ocorrência apurada e notificada — nunca do
/// nada, e nunca de uma denúncia solta.
model CasoRetomada {
  id           String       @id @default(cuid())
  tenantId     String
  unidadeId    String
  ocorrenciaId String?
  protocolo    String
  fase         FaseRetomada @default(ABERTO)

  /// Base legal invocada: cláusula do contrato, artigo da lei municipal, condição do edital.
  /// Texto livre porque cada município tem a sua — mas obrigatório, porque decisão sem fundamento
  /// não se sustenta.
  fundamentacaoLegal String
  descricao          String
  abertoEm           DateTime

  notificadoEm        DateTime?
  formaNotificacao    FormaNotificacao?
  /// Comprovante da ciência: AR digitalizado, termo assinado ou publicação do edital.
  comprovanteKey      String?
  /// Tentativas pessoais ou por AR que não encontraram a família. É o que autoriza o edital.
  tentativasFrustradas Int              @default(0)
  prazoDefesaAte      DateTime?

  defesaApresentadaEm DateTime?
  defesaTeor          String?
  defesaArquivoKey    String?
  /// Quem apresentou: o titular, um familiar, um advogado. Importa para a validade do ato.
  defesaApresentadaPor String?

  decisao            DecisaoRetomada?
  decididoEm         DateTime?
  decididoPor        String?
  /// Por que se decidiu assim, enfrentando o que a defesa alegou. É a peça que o juiz lê.
  fundamentacaoDecisao String?

  /// Encaminhamento ao Jurídico para a retomada de fato.
  encaminhamentoId String?
  /// Pilha documental do caso — o que o Jurídico recebe junto.
  pilhaId          String?

  encerradoEm     DateTime?
  motivoEncerramento String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String
  updatedBy String
  deletedAt DateTime?
  deletedBy String?

  unidade    UnidadeHabitacional @relation(fields: [unidadeId], references: [id], onDelete: Restrict)
  ocorrencia OcorrenciaUnidade?  @relation(fields: [ocorrenciaId], references: [id], onDelete: SetNull)
  atos       AtoDoCaso[]

  @@unique([tenantId, protocolo])
  @@index([tenantId, unidadeId, fase])
  @@index([tenantId, fase, prazoDefesaAte])
  @@map("caso_retomada")
}

/// Cada movimento do caso, em ordem. A trilha de auditoria já registra tudo, mas ela é do sistema;
/// esta é a linha do tempo que o processo mostra à família e ao juiz, em português.
model AtoDoCaso {
  id       String   @id @default(cuid())
  tenantId String
  casoId   String
  ordem    Int
  ocorridoEm DateTime
  titulo   String
  detalhe  String?
  /// Quem praticou o ato — servidor, família, ou o próprio sistema em ato de prazo.
  autor    String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String
  updatedBy String

  caso CasoRetomada @relation(fields: [casoId], references: [id], onDelete: Cascade)

  @@index([tenantId, casoId, ordem])
  @@map("ato_do_caso")
}
