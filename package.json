{
  "name": "habita",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Habita+ — Plataforma SaaS de Gestão Habitacional de Interesse Social",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24",
    "pnpm": ">=11"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\""
  },
  "devDependencies": {
    "@habita/config": "workspace:*",
    "eslint": "10.5.0",
    "prettier": "3.8.4",
    "turbo": "2.9.18",
    "typescript": "6.0.3"
  }
}
