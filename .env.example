# === Habita+ — exemplo de ambiente (NUNCA commitar o .env real) ===

# App
NODE_ENV=development
API_PORT=3334
WEB_PORT=3001
WEB_URL=http://localhost:3001
API_URL=http://localhost:3334/api/v1

# Banco (Postgres + PostGIS) — porta 55433 no host, ver infra/docker-compose.yml
POSTGRES_USER=habita
POSTGRES_PASSWORD=troque-em-producao
POSTGRES_DB=habita

# DATABASE_URL: papel OWNER. Usado só pela CLI do Prisma (migrate/studio).
DATABASE_URL=postgresql://habita:troque-em-producao@localhost:55433/habita?schema=public

# RUNTIME_DATABASE_URL: papel da aplicação (habita_app), SEM superuser e SEM BYPASSRLS.
# É o que o PrismaClient usa em runtime. Sem essa separação a RLS vira decorativa — o owner
# ignora policy. Criado por `pnpm --filter @habita/api db:bootstrap-role`.
# Não há fallback para DATABASE_URL de propósito: config de segurança não cai em valor mais
# permissivo em silêncio. O boot falha se estiver ausente.
RUNTIME_DATABASE_URL=postgresql://habita_app:troque-em-producao@localhost:55433/habita?schema=public
HABITA_APP_DB_PASSWORD=troque-em-producao

# Auth (JWT próprio — argon2id)
JWT_ACCESS_SECRET=gere-um-segredo-forte
JWT_REFRESH_SECRET=gere-outro-segredo-forte
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Flag Secure do cookie de sessão. Vazio = decide pelo protocolo da requisição (https → Secure).
# Só preencha quando a aplicação servir HTTPS sem proxy reverso que envie x-forwarded-proto:
# aí o servidor não tem como saber, e "true" é a resposta certa.
# Nunca marque true servindo por http — o navegador descarta o cookie e ninguém consegue entrar.
COOKIE_SECURE=

# Storage (MinIO — S3 compatible)
MINIO_ROOT_USER=habita
MINIO_ROOT_PASSWORD=troque-em-producao
MINIO_ENDPOINT=http://localhost:9310
MINIO_BUCKET=habita

# Assistente de IA (spec §12). Sem chave, o produto funciona inteiro — só o atalho do rascunho
# não aparece. O que sai daqui vai mascarado (CPF, NIS, telefone, endereço) e fica registrado em
# sugestao_ia com o desfecho: aceita, editada ou rejeitada.
# A IA NUNCA calcula pontuação, ordena fila, decide contemplação, corte de benefício ou retomada.
ANTHROPIC_API_KEY=
IA_MODELO=claude-sonnet-5

# Integração com o Regulariza+ (§2 e §6.4 da spec): consulta por CPF via API, chave de escopo
# restrito. O Habita+ NUNCA lê o banco do irmão — só pergunta, e as duas pontas auditam a leitura.
REGULARIZA_API_URL=http://localhost:3333
REGULARIZA_API_KEY=

# E-mail transacional
RESEND_API_KEY=

# Tenant default (timezone IANA)
DEFAULT_TENANT_TIMEZONE=America/Cuiaba
